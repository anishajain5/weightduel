{
  "name": "@wid/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "prisma generate && esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=cjs --outfile=../../api/index.js --external:argon2 --external:@prisma/client --external:.prisma/client --define:import.meta.url=__importMetaUrl \"--banner:js=const __importMetaUrl=require('url').pathToFileURL(__filename).href;\" --legal-comments=none --log-level=warning"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.8.0",
    "@wid/shared": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "jose": "^6.2.12",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
